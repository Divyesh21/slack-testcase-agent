# ── Secrets — NEVER commit these ──────────────────────────────────────────────
.env
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
.venv/
.lambda-venv/
env/

# ── Build artefacts ───────────────────────────────────────────────────────────
# macOS-built Lambda package — wrong platform binaries, use Dockerfile instead
lambda-package/
*.zip

# ChromaDB local store (ephemeral dev data)
chroma_store/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── SAM / CloudFormation build cache ─────────────────────────────────────────
.aws-sam/

# ── Local dev only ────────────────────────────────────────────────────────────
.dev-venv/
*.save

# ── Duplicate / legacy files ──────────────────────────────────────────────────
"editage_kb/chinaNew (2).docx"
