# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values for local development.
# NEVER commit .env to source control.
# In AWS Lambda, these are set as Lambda environment variables (via SSM).
# ─────────────────────────────────────────────────────────────────────────────

# ── Slack ─────────────────────────────────────────────────────────────────────
# From https://api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=<paste-bot-token-here>

# From https://api.slack.com/apps → Your App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=<paste-signing-secret-here>

# ── OpenAI ────────────────────────────────────────────────────────────────────
# From https://platform.openai.com/api-keys
OPENAI_API_KEY=<paste-openai-api-key-here>

# Optional: override the default models
GEN_MODEL=gpt-4o-mini
EMB_MODEL=text-embedding-3-small

# ── Jira ─────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@your-org.com
# From https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token-here

# ── Knowledge base (local dev only) ─────────────────────────────────────────
# In Lambda, editage_kb/ is bundled inside the container image.
KB_DIR=./editage_kb
PERSIST_DIR=./chroma_store
